node_modules/
dist/
.next/
out/
*.tsbuildinfo

# Raw upstream dumps: large, re-downloadable, never committed.
data/raw/

# Built artifacts ARE committed (see data/build/README.md) so the app can
# deploy to Vercel with no database. Comment the next line out if they grow.
# data/build/

# Every artifact write is temp-file-then-rename. A .tmp left behind means a
# process died mid-write; it is never something to commit.
data/build/*.tmp

# Secrets. .env.example is ignored ON PURPOSE and is NOT the usual convention:
# it is used here as a personal key store, so it must never be committed. The
# tracked documentation lives in .env.template instead, which holds no secrets.
#
# Adding a path here does NOT untrack a file git already knows about — that
# needs `git rm --cached <file>`. .env.example was already tracked, so it was
# untracked explicitly when this rule was added.
.env
.env.local
.env*.local
.env.example

.DS_Store
Thumbs.db
