# ---------------------------------------------------------------------------
# Searchski configuration. Copy to .env.local and fill in.
# EVERY value here is optional. With none of them set, the app runs entirely
# from the committed JSON artifacts in data/build/ — no database, no API keys.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# "static" (default) reads data/build/*.json. "supabase" reads Postgres.
SEARCHSKI_DATA_SOURCE=static

# --- Supabase (Stage 0 optional upgrade) -----------------------------------
# From Supabase dashboard > Project Settings > Database / API.
# DATABASE_URL is used by the ETL loader (server-side, never shipped to browser).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API (Stage 3: natural-language query parsing) -------------------
# Without this the app falls back to deterministic keyword parsing, which works.
# The same key also unlocks `npm run prices:discover` (offline, seasonal, opt-in
# — it costs money and reads third-party sites, so it never runs without one).
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Weather (Stage 1 conditions) ------------------------------------------
# Open-Meteo needs NO key on the free tier, but that tier is NON-COMMERCIAL.
# Set this to "paid" and add the key once the site earns affiliate revenue.
CONDITIONS_PROVIDER=openmeteo_free
# OPENMETEO_API_KEY=

# --- Affiliates (Stage 2: link-out only, never a package sale) --------------
# Absent values degrade to plain unattributed links, which still work.
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_TOKEN=
# LITEAPI_KEY=
