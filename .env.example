# ---------------------------------------------------------------------------
# Searchski configuration. Copy to .env.local and fill in.
# EVERY value here is optional. With none of them set, the app runs entirely
# from the committed JSON artifacts in data/build/ — no database, no API keys.
#
# WINDOWS: DO NOT create this file with `Set-Content -Encoding utf8` or `>`.
# PowerShell 5.1 writes a UTF-8 BOM (EF BB BF), and Node's --env-file parser
# reads those three bytes as part of the FIRST key name. The result is that the
# first variable in the file silently does not load, and the tool reports "no
# API key set" while staring straight at one. Verified, not theoretical.
#
# Safe ways to create it:
#   copy .env.example .env.local          (cmd/PowerShell — copies bytes as-is)
#   [IO.File]::WriteAllText("$PWD\.env.local", "ANTHROPIC_API_KEY=sk-ant-...`n")
# Or just edit it in VS Code, which writes UTF-8 without a BOM by default.
#
# To check a file you already made:
#   (Get-Content .env.local -Encoding Byte -TotalCount 3) -join ' '
# "239 187 191" means it has a BOM. Anything else is fine.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# "static" (default) reads data/build/*.json. "supabase" reads Postgres.
SEARCHSKI_DATA_SOURCE=static

# --- Supabase (Stage 0 optional upgrade) -----------------------------------
# From Supabase dashboard > Project Settings > Database / API.
# DATABASE_URL is used by the ETL loader (server-side, never shipped to browser).
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API (Stage 3: natural-language query parsing) -------------------
# Without this the app falls back to deterministic keyword parsing, which works.
# The same key also unlocks `npm run prices:discover` (offline, seasonal, opt-in
# — it costs money and reads third-party sites, so it never runs without one).
#
# >>> THIS FILE IS COMMITTED TO GIT. NEVER PUT A REAL KEY HERE. <<<
# Put it in .env.local, which is gitignored. This file exists only to document
# which variables exist. A real key on the line below will be pushed to GitHub.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Weather (Stage 1 conditions) ------------------------------------------
# Open-Meteo needs NO key on the free tier, but that tier is NON-COMMERCIAL.
# Set this to "paid" and add the key once the site earns affiliate revenue.
CONDITIONS_PROVIDER=openmeteo_free
# OPENMETEO_API_KEY=

# --- Affiliates (Stage 2: link-out only, never a package sale) --------------
# Absent values degrade to plain unattributed links, which still work.
# TRAVELPAYOUTS_MARKER=
# TRAVELPAYOUTS_TOKEN=
# LITEAPI_KEY=
