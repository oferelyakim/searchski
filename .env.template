# ---------------------------------------------------------------------------
# Searchski configuration TEMPLATE. Committed to git — NEVER put a secret here.
#
#   .env.template   this file. Tracked. Documents which variables exist.
#   .env.example    gitignored. Your personal copy; safe to hold real keys.
#   .env.local      gitignored. Standard Next.js name; highest precedence.
#
# All three are loaded by the ETL scripts, in that order, so later files win.
# Next.js itself only reads .env / .env.local, so for the WEB APP use .env.local.
#
# EVERY value below is optional. With none of them set, the app runs entirely
# from the committed JSON artifacts in data/build/ — no database, no API keys.
#
# WINDOWS: do NOT create these files with `Set-Content -Encoding utf8` or `>`.
# PowerShell 5.1 writes a UTF-8 BOM (EF BB BF), and Node's --env-file parser
# reads those three bytes as part of the FIRST key name. The variable silently
# does not load and the tool reports "no API key set" while staring at one.
# Verified, not theoretical.
#
#   copy .env.template .env.local     <- safe, copies bytes as-is
#
# To check a file you already made:
#   (Get-Content .env.local -Encoding Byte -TotalCount 3) -join ' '
# "239 187 191" means it has a BOM. Anything else is fine.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# "static" (default) reads data/build/*.json. "supabase" reads Postgres.
SEARCHSKI_DATA_SOURCE=static

# --- Supabase (optional upgrade) -------------------------------------------
# DATABASE_URL is used by the ETL loader only. Never add it to Vercel.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API ------------------------------------------------------------
# Natural-language query parsing, per-result explanations, and the pass-price
# discovery tool. Without it the app falls back to keyword parsing, which works.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Weather ---------------------------------------------------------------
# Open-Meteo needs NO key on the free tier, but that tier is NON-COMMERCIAL.
# Move to the paid tier once the site earns affiliate revenue.
CONDITIONS_PROVIDER=openmeteo_free
# OPENMETEO_API_KEY=

# --- Affiliates (link-out only, never a package sale) ----------------------
# All free accounts. Absent values degrade to plain unattributed links that
# still work — nothing here is required for the site to function.
#
# TRAVELPAYOUTS_MARKER covers flights, hotels AND transfers (Kiwitaxi,
# GetTransfer) from one account.
# TRAVELPAYOUTS_MARKER=
# BOOKING_AID=
# LITEAPI_KEY=
# AFFILIATE_SUB_ID=
